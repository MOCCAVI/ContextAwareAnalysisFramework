module org.dataflowanalysis.contextawareframework.mwe2

import tools.mdsd.ecoreworkflow.mwe2lib.bean.EclipseRCPSupportingStandaloneSetup
import tools.mdsd.ecoreworkflow.mwe2lib.component.URISupportingDirectoryCleaner

var workspaceRoot = "../../../"

Workflow {
	bean = EclipseRCPSupportingStandaloneSetup {
		scanClassPath = true
		platformUri = workspaceRoot		
	}

	component = URISupportingDirectoryCleaner {
		directory = "platform:/resource/org.dataflowanalysis.contextawareframework.metamodel/src-gen"
		directory = "platform:/resource/org.dataflowanalysis.contextawareframework.metamodel.edit/src-gen"
		directory = "platform:/resource/org.dataflowanalysis.contextawareframework.metamodel.editor/src-gen"
	}
}
