<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.dataflowanalysis.contextawareframework</groupId>
		<artifactId>bundles</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../</relativePath>
	</parent>
	<artifactId>contextawareframework.metamodel</artifactId>
	<packaging>jar</packaging>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.core.runtime</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.core.resources</artifactId>
		</dependency>
		<dependency>
			<groupId>${vendor.groupId}</groupId>
			<artifactId>tools.mdsd.modelingfoundations.identifier</artifactId>
		</dependency>
		<dependency>
			<groupId>${dfa.groupId}</groupId>
			<artifactId>dfd.dataflowdiagram</artifactId>
		</dependency>
		<dependency>
			<groupId>${dfa.groupId}</groupId>
			<artifactId>dfd.datadictionary</artifactId>
		</dependency>

		<!-- EMF/MWE2 codegen toolchain, used only by the generate-model-code execution below.
		     `provided` scope keeps it available on this module's own compile/exec classpath
		     without leaking into downstream consumers' transitive dependencies. -->
		<dependency>
			<groupId>${vendor.groupId}</groupId>
			<artifactId>tools.mdsd.ecoreworkflow.mwe2lib</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe.utils</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe.core</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe2.launch</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe2.lib</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe2.language</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe2.runtime</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.xbase</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.codegen.ecore</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>log4j</groupId>
			<artifactId>log4j</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Resolves the absolute jar path of DataFlowAnalysis's dfd.dataflowdiagram/
			     dfd.datadictionary artifacts (a separate Maven reactor, so there's no sibling
			     source tree to point the mwe2 codegen at). The resulting properties are passed
			     to generate-context.mwe2 below as archive: URIs so EcoreGenerator can resolve
			     context.genmodel's usedGenPackages straight out of the dependency jars. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>resolve-dfd-genmodel-jars</id>
						<phase>initialize</phase>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Regenerates this bundle's own model code (base only, not edit/editor); see
			     releng/org.dataflowanalysis.contextawareframework.mwe2/workflow/generate-context.mwe2.
			     Scoped per-bundle (rather than one shared invocation covering all three model/
			     edit/editor bundles) so this always runs after THIS module's own `clean`; a
			     shared cross-module invocation would get wiped by a sibling's later clean
			     phase in the same `mvn clean ...` run. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>generate-model-code</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<!-- In-process (not a forked OS process): exec:exec silently drops
							     everything after "!" when it reconstructs the command line for
							     the external process, which breaks the archive: URIs below. -->
							<mainClass>org.eclipse.emf.mwe2.launch.runtime.Mwe2Launcher</mainClass>
							<classpathScope>compile</classpathScope>
							<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
							<arguments>
								<argument>${maven.multiModuleProjectDirectory}/releng/org.dataflowanalysis.contextawareframework.mwe2/workflow/generate-context.mwe2</argument>
								<argument>-p</argument>
								<argument>dfdDataDictionaryGenModelUri=archive:file:${org.dataflowanalysis.analysis:dfd.datadictionary:jar}!/model/datadictionary.genmodel</argument>
								<argument>-p</argument>
								<argument>dfdDataFlowDiagramGenModelUri=archive:file:${org.dataflowanalysis.analysis:dfd.dataflowdiagram:jar}!/model/dataflowdiagram.genmodel</argument>
								<argument>-p</argument>
								<argument>dfdDataDictionaryEcoreUri=archive:file:${org.dataflowanalysis.analysis:dfd.datadictionary:jar}!/model/datadictionary.ecore</argument>
								<argument>-p</argument>
								<argument>dfdDataFlowDiagramEcoreUri=archive:file:${org.dataflowanalysis.analysis:dfd.dataflowdiagram:jar}!/model/dataflowdiagram.ecore</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-generated-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/mwe2</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
